FROM fedora:42
LABEL org.opencontainers.image.authors="Brenden Davidson <brenden@bdavidson.dev>"
LABEL org.opencontainers.image.source="https://github.com/iAmSomeone2/compressonator"
LABEL org.opencontainers.image.description="Fedora 42-based image containing build dependencies for Compressonator"
LABEL org.opencontainers.image.licenses="MIT"

# Upgrade installed pkgs and install all build dependencies
RUN dnf upgrade -y && \
    dnf install -y --setopt=install_weak_deps=False \
    gcc-c++ ninja-build ccache cmake git libicu-devel \
    vulkan-tools vulkan-headers glslang-devel \
    mesa-libGL-devel mesa-libGLU-devel mesa-libEGL-devel mesa-libOpenCL-devel \
    qt5-qtbase-devel qt5-qtdeclarative-devel qt5-qtwebengine-devel \
    glew-devel glfw-devel glm-devel opencv-devel openexr-devel \
    libpng-devel wayland-devel python3-sphinx && \
    dnf clean all -y
